#!/usr/bin/env python3
"""Show requests and correlated responses from a Claude network JSONL trace."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path


def default_directory() -> Path:
    explicit = os.environ.get("CLAUDE_NETWORK_TRACE_DIR")
    if explicit:
        return Path(explicit).expanduser()
    state_home = os.environ.get("XDG_STATE_HOME")
    if state_home:
        return Path(state_home).expanduser() / "trace-claude-code"
    return Path.home() / ".local" / "state" / "trace-claude-code"


def latest_trace(directory: Path) -> Path:
    traces = sorted(directory.glob("claude-network-*.jsonl"), key=lambda item: item.stat().st_mtime)
    if not traces:
        raise SystemExit(f"no traces found in {directory}")
    return traces[-1]


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("trace", nargs="?", type=Path, help="JSONL trace; defaults to the newest trace")
    parser.add_argument("--directory", type=Path, default=default_directory(), help="directory used to find the newest trace")
    parser.add_argument("--bodies", action="store_true", help="print captured request bodies")
    parser.add_argument("--headers", action="store_true", help="print request and response headers")
    parser.add_argument("--connections", action="store_true", help="include connection/socket records")
    return parser.parse_args()


def print_body(body: dict) -> None:
    if body.get("encoding") == "utf8":
        print(body.get("text", ""))
    elif body.get("encoding") == "base64":
        print(f"<base64 {body.get('capturedBytes', 0)} bytes> {body.get('data', '')}")
    else:
        print(f"<body omitted: {body.get('reason', 'unavailable')}>")


def main() -> int:
    args = parse_args()
    trace = args.trace or latest_trace(args.directory.expanduser())
    records = [json.loads(line) for line in trace.read_text(encoding="utf-8").splitlines() if line.strip()]
    responses: dict[str, list[dict]] = {}
    for record in records:
        request_id = record.get("requestId")
        if request_id and record.get("phase") in {"response", "response-end", "error"}:
            responses.setdefault(request_id, []).append(record)

    print(f"trace: {trace}")
    for record in records:
        phase = record.get("phase")
        layer = record.get("layer")
        if phase == "request":
            request_id = record.get("requestId", "-")
            body = record.get("body") or {}
            print(
                f"\n[{request_id}] {record.get('transport', '-')} "
                f"{record.get('method', '-')} {record.get('url', '-')} "
                f"body={body.get('bytes', 0)}B"
                f"{' truncated' if body.get('truncated') else ''}"
            )
            if args.headers:
                print("request headers:")
                print(json.dumps(record.get("headers", {}), ensure_ascii=False, indent=2))
            if args.bodies:
                print("request body:")
                print_body(body)
            for response in responses.get(request_id, []):
                if response.get("phase") == "response":
                    print(
                        f"response: {response.get('status', '-')} "
                        f"{response.get('statusText') or response.get('statusMessage') or ''} "
                        f"{response.get('durationMs', '-')}ms"
                    )
                    if args.headers:
                        print("response headers:")
                        print(json.dumps(response.get("headers", {}), ensure_ascii=False, indent=2))
                elif response.get("phase") == "response-end":
                    if args.bodies:
                        print("response body:")
                        print_body(response.get("body") or {})
                elif response.get("phase") == "error":
                    print(f"error: {response.get('error')}")
        elif args.connections and layer in {"connection", "socket", "websocket"}:
            print(json.dumps(record, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
