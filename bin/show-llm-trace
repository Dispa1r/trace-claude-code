#!/usr/bin/env python3
"""Show only LLM /v1/messages traces from a Claude network JSONL trace."""

from __future__ import annotations

import argparse
import base64
import json
import os
from pathlib import Path
from typing import Any
from urllib.parse import urlparse


def default_directory() -> Path:
    explicit = os.environ.get("CLAUDE_NETWORK_TRACE_DIR")
    if explicit:
        return Path(explicit).expanduser()
    state_home = os.environ.get("XDG_STATE_HOME")
    if state_home:
        return Path(state_home).expanduser() / "trace-claude-code"
    return Path.home() / ".local" / "state" / "trace-claude-code"


def latest_trace(directory: Path) -> Path:
    traces = sorted(directory.glob("claude-network-*.jsonl"), key=lambda item: item.stat().st_mtime)
    if not traces:
        raise SystemExit(f"no traces found in {directory}")
    return traces[-1]


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("trace", nargs="?", type=Path, help="JSONL trace; defaults to the newest trace")
    parser.add_argument("--directory", type=Path, default=default_directory(), help="directory used to find the newest trace")
    parser.add_argument("--headers", action="store_true", help="print request and response headers")
    parser.add_argument("--raw-response", action="store_true", help="print raw response body in addition to parsed output")
    return parser.parse_args()


def is_messages_url(url: str) -> bool:
    try:
        path = urlparse(url).path
    except Exception:
        path = url
    return "/v1/messages" in path


def decode_body(body: dict[str, Any] | None) -> str | None:
    if not body:
        return None
    if body.get("omitted"):
        return None
    encoding = body.get("encoding")
    if encoding == "utf8":
        return str(body.get("text", ""))
    if encoding == "base64":
        try:
            raw = base64.b64decode(str(body.get("data", "")), validate=False)
            return raw.decode("utf-8", errors="replace")
        except Exception:
            return None
    return None


def parse_json_text(text: str | None) -> Any | None:
    if text is None:
        return None
    try:
        return json.loads(text)
    except Exception:
        return None


def normalize_system(value: Any) -> list[Any]:
    if value is None:
        return []
    if isinstance(value, str):
        return [{"type": "text", "text": value}]
    if isinstance(value, list):
        return value
    return [value]


def parse_sse(text: str) -> list[dict[str, Any]]:
    events: list[dict[str, Any]] = []
    event_name = "message"
    data_lines: list[str] = []
    event_id: str | None = None

    def flush() -> None:
        nonlocal event_name, data_lines, event_id
        if not data_lines and event_id is None and event_name == "message":
            return
        data = "\n".join(data_lines)
        parsed = None
        if data and data != "[DONE]":
            try:
                parsed = json.loads(data)
            except Exception:
                parsed = None
        events.append({
            "event": event_name,
            "id": event_id,
            "data": data,
            "json": parsed,
        })
        event_name = "message"
        data_lines = []
        event_id = None

    for raw_line in text.splitlines():
        if raw_line == "":
            flush()
            continue
        if raw_line.startswith(":"):
            continue
        if raw_line.startswith("event:"):
            event_name = raw_line[6:].lstrip()
        elif raw_line.startswith("data:"):
            data_lines.append(raw_line[5:].lstrip())
        elif raw_line.startswith("id:"):
            event_id = raw_line[3:].lstrip()
    flush()
    return events


def summarize_sse(events: list[dict[str, Any]]) -> dict[str, Any]:
    blocks: dict[int, dict[str, Any]] = {}
    message: dict[str, Any] = {}
    usage: dict[str, Any] = {}
    stop_reason: Any = None
    stop_sequence: Any = None

    for event in events:
        payload = event.get("json")
        if not isinstance(payload, dict):
            continue
        kind = str(event.get("event") or payload.get("type") or "")
        if kind == "message_start":
            message = dict(payload.get("message") or {})
            usage = dict(message.get("usage") or {})
        elif kind == "content_block_start":
            index = payload.get("index")
            if not isinstance(index, int):
                continue
            content_block = dict(payload.get("content_block") or {})
            blocks[index] = {
                "index": index,
                "type": content_block.get("type"),
                "id": content_block.get("id"),
                "name": content_block.get("name"),
                "text": content_block.get("text", "") if isinstance(content_block.get("text"), str) else "",
                "thinking": content_block.get("thinking", "") if isinstance(content_block.get("thinking"), str) else "",
                "partial_json": "",
                "input": content_block.get("input"),
            }
        elif kind == "content_block_delta":
            index = payload.get("index")
            if not isinstance(index, int):
                continue
            block = blocks.setdefault(index, {
                "index": index,
                "type": None,
                "id": None,
                "name": None,
                "text": "",
                "thinking": "",
                "partial_json": "",
                "input": None,
            })
            delta = dict(payload.get("delta") or {})
            delta_type = delta.get("type")
            if block.get("type") is None:
                if delta_type == "text_delta":
                    block["type"] = "text"
                elif delta_type == "thinking_delta":
                    block["type"] = "thinking"
                elif delta_type == "input_json_delta":
                    block["type"] = "tool_use"
            if isinstance(delta.get("text"), str):
                block["text"] += delta["text"]
            if isinstance(delta.get("thinking"), str):
                block["thinking"] += delta["thinking"]
            if isinstance(delta.get("partial_json"), str):
                block["partial_json"] += delta["partial_json"]
        elif kind == "message_delta":
            delta = dict(payload.get("delta") or {})
            usage_delta = dict(payload.get("usage") or {})
            if delta.get("stop_reason") is not None:
                stop_reason = delta.get("stop_reason")
            if delta.get("stop_sequence") is not None:
                stop_sequence = delta.get("stop_sequence")
            usage.update(usage_delta)

    ordered_blocks = [blocks[index] for index in sorted(blocks)]
    assistant_text_parts: list[str] = []
    thinking_parts: list[str] = []
    tool_uses: list[dict[str, Any]] = []

    for block in ordered_blocks:
        if block.get("type") == "text" and block.get("text"):
            assistant_text_parts.append(str(block["text"]))
        elif block.get("type") == "thinking" and block.get("thinking"):
            thinking_parts.append(str(block["thinking"]))
        elif block.get("type") == "tool_use":
            parsed_input = block.get("input")
            partial_json = block.get("partial_json")
            if parsed_input is None and isinstance(partial_json, str) and partial_json:
                try:
                    parsed_input = json.loads(partial_json)
                except Exception:
                    parsed_input = partial_json
            tool_uses.append({
                "id": block.get("id"),
                "name": block.get("name"),
                "input": parsed_input,
            })

    return {
        "message": {
            "id": message.get("id"),
            "model": message.get("model"),
            "role": message.get("role"),
            "stop_reason": stop_reason if stop_reason is not None else message.get("stop_reason"),
            "stop_sequence": stop_sequence if stop_sequence is not None else message.get("stop_sequence"),
            "usage": usage or message.get("usage"),
        },
        "assistant_text": "".join(assistant_text_parts),
        "thinking": "".join(thinking_parts),
        "tool_uses": tool_uses,
        "events": len(events),
    }


def body_label(body: dict[str, Any] | None) -> str:
    if not body:
        return "missing"
    if body.get("omitted"):
        return f"omitted ({body.get('reason', 'unavailable')})"
    return f"{body.get('bytes', 0)}B{' truncated' if body.get('truncated') else ''}"


def print_json_block(title: str, value: Any) -> None:
    print(f"{title}:")
    print(json.dumps(value, ensure_ascii=False, indent=2))


def main() -> int:
    args = parse_args()
    trace = args.trace or latest_trace(args.directory.expanduser())
    records = [json.loads(line) for line in trace.read_text(encoding="utf-8").splitlines() if line.strip()]

    by_request: dict[str, list[dict[str, Any]]] = {}
    for record in records:
        request_id = record.get("requestId")
        if request_id:
            by_request.setdefault(request_id, []).append(record)

    matched = 0
    print(f"trace: {trace}")
    for record in records:
        if record.get("phase") != "request":
            continue
        url = str(record.get("url", ""))
        if not is_messages_url(url):
            continue

        matched += 1
        request_id = str(record.get("requestId", "-"))
        related = by_request.get(request_id, [])
        response = next((item for item in related if item.get("phase") == "response"), None)
        response_end = next((item for item in related if item.get("phase") == "response-end"), None)
        error = next((item for item in related if item.get("phase") == "error"), None)

        body = record.get("body") or {}
        request_text = decode_body(body)
        request_json = parse_json_text(request_text)

        print(f"\n[{request_id}] {record.get('timestamp', '-')}")
        print(f"{record.get('method', '-')} {url}")
        print(f"request body: {body_label(body)}")

        if args.headers:
            print_json_block("request headers", record.get("headers", {}))

        if isinstance(request_json, dict):
            summary = {
                "model": request_json.get("model"),
                "stream": request_json.get("stream"),
                "max_tokens": request_json.get("max_tokens"),
                "temperature": request_json.get("temperature"),
                "tool_choice": request_json.get("tool_choice"),
            }
            print_json_block("request summary", summary)
            print_json_block("system", normalize_system(request_json.get("system")))
            print_json_block("messages", request_json.get("messages", []))
            print_json_block("tools", request_json.get("tools", []))
        elif request_text is not None:
            print("request body text:")
            print(request_text)
        else:
            print("request body text:")
            print(f"<{body_label(body)}>")

        if response is not None:
            print(
                "response summary: "
                f"{response.get('status', '-')} "
                f"{response.get('statusText') or response.get('statusMessage') or ''} "
                f"{response.get('durationMs', '-')}ms"
            )
            if args.headers:
                print_json_block("response headers", response.get("headers", {}))
        elif error is not None:
            print(f"response error: {error.get('error')}")
        else:
            print("response summary: <pending or missing>")

        response_body = (response_end or {}).get("body") or {}
        response_text = decode_body(response_body)
        content_type = ""
        if isinstance(response, dict):
            headers = response.get("headers", {})
            for key, value in headers.items():
                if str(key).lower() == "content-type":
                    content_type = value if isinstance(value, str) else ",".join(value)
                    break

        print(f"response body: {body_label(response_body)}")
        if response_text is None:
            if response_body:
                print(f"<{body_label(response_body)}>")
            continue

        if "event-stream" in content_type or response_text.startswith("event:") or "\ndata:" in response_text:
            events = parse_sse(response_text)
            summary = summarize_sse(events)
            print_json_block("response sse summary", summary)
        else:
            response_json = parse_json_text(response_text)
            if response_json is not None:
                print_json_block("response json", response_json)
            else:
                print("response text:")
                print(response_text)

        if args.raw_response:
            print("response raw body:")
            print(response_text)

    if matched == 0:
        print("\nno /v1/messages requests found")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
